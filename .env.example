# Backend Configuration
BACKEND_PORT=8080
# Release tag the compose stack pulls; defaults to the pinned current release (DOCKER.md).
# HOMER_VERSION=1.44.0
JAVA_OPTS=-Xmx512m -Xms256m
# Local development without a token: CONFIG_PATH=config/config-local.json (no API auth) with
# AUTH_ENABLED=false below; keep the backend bound to 127.0.0.1 (DOCKER.md).
CONFIG_PATH=config/config.json

# REQUIRED: admin API bearer token; startup fails while it is empty. Generate one with
# echo "HOMER_ADMIN_TOKEN=$(openssl rand -hex 24)" >> .env
HOMER_ADMIN_TOKEN=

# Frontend Configuration
# Also the backend's allowed console origin (localhost:<FRONTEND_PORT>), so change the port only here.
FRONTEND_PORT=3000
# Console sign-in with HOMER_ADMIN_TOKEN on the Token tab, for this loopback-only quick start;
# a real deployment uses cookie sign-in with CONSOLE_ALLOW_BEARER off (DOCKER.md).
AUTH_ENABLED=true
CONSOLE_ALLOW_BEARER=true

# CONSOLE_HOMER_API_URL is the backend URL as the browser reaches it; it defaults to
# localhost:<BACKEND_PORT>, so set it behind a reverse proxy (DOCKER.md).

# Runtime console plugins and themes, from the console image's public/ (DOCKER.md), e.g.
# CONSOLE_PLUGINS=/plugins/costs.js@admin

# Docker Configuration
COMPOSE_PROJECT_NAME=homer
