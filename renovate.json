{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["before 6am on monday"],
  "timezone": "Europe/Prague",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "automerge": false,
  "labels": ["dependencies"],
  "enabledManagers": [
    "gradle",
    "npm",
    "pip-compile",
    "dockerfile",
    "docker-compose",
    "github-actions",
    "custom.regex"
  ],
  "gradle": {
    "managerFilePatterns": [
      "/^app/gradle/libs\\.versions\\.toml$/",
      "/^app/(buildSrc/)?(build|settings)\\.gradle\\.kts$/",
      "/^app/buildSrc/src/main/kotlin/.+\\.gradle\\.kts$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "The release image matrix names its runners in `runner:` values, which the github-actions manager does not read.",
      "managerFilePatterns": ["/^\\.github/workflows/release\\.yml$/"],
      "matchStrings": ["runner:\\s*(?<depName>ubuntu)-(?<currentValue>\\d+\\.\\d+(?:-arm)?)\\s"],
      "datasourceTemplate": "github-runners",
      "versioningTemplate": "docker"
    }
  ],
  "pip-compile": {
    "managerFilePatterns": [
      "/^clients/python/requirements(-test)?\\.lock$/",
      "/^tools/pip-audit/requirements\\.txt$/"
    ]
  },
  "packageRules": [
    {
      "description": "Keep Docker base images pinned to a tag + digest and open PRs when the digest (security patches) or tag changes.",
      "matchDatasources": ["docker"],
      "pinDigests": true
    },
    {
      "description": "One weekly pull request per ecosystem.",
      "matchManagers": ["gradle"],
      "groupName": "Gradle dependencies"
    },
    {
      "matchManagers": ["npm"],
      "matchFileNames": ["console/**"],
      "groupName": "console npm dependencies"
    },
    {
      "matchManagers": ["npm"],
      "matchFileNames": ["site/**"],
      "groupName": "site npm dependencies"
    },
    {
      "matchManagers": ["npm"],
      "matchFileNames": ["tools/quality/**"],
      "groupName": "quality tooling npm dependencies"
    },
    {
      "matchManagers": ["npm"],
      "matchFileNames": ["example/**"],
      "groupName": "example plugin npm dependencies"
    },
    {
      "description": "Homer's own default image tag moves with a release, not with Renovate.",
      "matchPackageNames": ["ghcr.io/livesport/homer/**"],
      "enabled": false
    },
    {
      "matchManagers": ["pip-compile"],
      "groupName": "Python dependencies"
    },
    {
      "matchManagers": ["dockerfile", "docker-compose"],
      "groupName": "Docker images"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "The release matrix's runners move with every other job's runs-on label.",
      "matchDatasources": ["github-runners"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Dependencies held by a docs/workarounds.md row: a pull request of their own, labelled so the row is re-checked in it.",
      "matchPackageNames": [
        "io.ktor:**",
        "io.modelcontextprotocol:**",
        "com.squareup.okhttp3:**",
        "com.squareup.okio:**",
        "com.langfuse:**",
        "com.networknt:**",
        "io.kubernetes:**",
        "org.jetbrains.exposed:**",
        "dev.detekt:**",
        "dev.detekt",
        "eclipse-temurin",
        "node"
      ],
      "groupName": null,
      "addLabels": ["workaround-pin"],
      "automerge": false
    }
  ]
}
